{
  "name": "PhishPipeline",
  "version": "1.1",
  "manifest_version": 3,
  "description": "Instant phishing detection powered by PhishPipeline AI.",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://phishpipeline-production-2212.up.railway.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishPipeline"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
