{
  "name": "PhishPipeline",
  "version": "1.0",
  "manifest_version": 3,
  "description": "Instant phishing detection for any URL.",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishPipeline"
  },
  "background": {
    "service_worker": "background.js"
  }
}
